{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sos.agency/s-passport/authority-envelope/v1",
  "title": "S/Passport Authority Envelope",
  "description": "The canonical, machine-readable authority boundary issued with an S/Agent Passport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner", "purpose", "capabilities", "constraints", "delegation", "lifecycle"],
  "properties": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_identity", "controller"],
      "properties": {
        "root_identity": { "type": "string", "description": "Seif-controlled sovereign root identity reference." },
        "controller": { "type": "string", "description": "Owner or policy-controller identifier." }
      }
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_:.\\-]{1,127}$" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_limit", "data_domains", "spend_limit", "credential_ttl_seconds"],
      "properties": {
        "action_limit": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "data_domains": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "spend_limit": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "credential_ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 2592000 },
        "allowed_external_systems": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "reversible_actions_only": { "type": "boolean", "default": true }
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "may_delegate"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 8 },
        "may_delegate": { "type": "boolean" },
        "child_capabilities_must_be_subset": { "const": true }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at", "revocation_mode", "quarantine_mode"],
      "properties": {
        "expires_at": { "type": "string", "format": "date-time" },
        "revocation_mode": { "enum": ["live", "immediate"] },
        "quarantine_mode": { "enum": ["automatic_on_anomaly", "manual_only"] }
      }
    }
  }
}
