{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S/Binance signed webhook relay envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_id",
    "connector",
    "mode",
    "received_at",
    "event"
  ],
  "properties": {
    "delivery_id": {
      "type": "string",
      "description": "Unique, receiver-idempotency key generated by S/Binance relay."
    },
    "connector": {
      "const": "S/Binance"
    },
    "mode": {
      "const": "read_only"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "subscription_id": {
      "type": ["integer", "null"]
    },
    "event": {
      "type": "object",
      "additionalProperties": true,
      "required": ["e", "E"],
      "properties": {
        "e": {
          "enum": [
            "outboundAccountPosition",
            "balanceUpdate",
            "executionReport",
            "externalLockUpdate",
            "eventStreamTerminated",
            "serverShutdown"
          ]
        },
        "E": {
          "type": "integer",
          "description": "Binance event timestamp in milliseconds UTC."
        }
      }
    }
  },
  "x-signature": {
    "header": "X-S-Binance-Signature",
    "algorithm": "HMAC-SHA256",
    "input": "Exact UTF-8 request body",
    "encoding": "hex"
  },
  "x-replay-protection": {
    "header": "X-S-Binance-Delivery",
    "value": "Must equal body.delivery_id",
    "receiver_behavior": "Persist delivery IDs and return success for duplicates without repeating downstream work."
  }
}
